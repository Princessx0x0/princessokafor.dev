<script>
  // Typewriter
  const phrases = ['building things that should not exist yet', 'GCP · Gemini · FastAPI · Cloud Run', 'shipping VERA — AI hiring, done fairly'];
  let pi = 0, ci = 0, del = false;
  const el = document.getElementById('tw');
  function type() {
    const cur = phrases[pi];
    if (!del) {
      el.textContent = cur.slice(0, ++ci);
      if (ci === cur.length) {
        if (pi === phrases.length - 1) return;
        setTimeout(() => { del = true; type(); }, 2000);
        return;
      }
      setTimeout(type, 42);
    } else {
      el.textContent = cur.slice(0, --ci);
      if (ci === 0) { del = false; pi++; setTimeout(type, 350); return; }
      setTimeout(type, 20);
    }
  }
  setTimeout(type, 900);

  // Scroll fade
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
  }, { threshold: 0.08 });
  document.querySelectorAll('.fade-up').forEach(el => obs.observe(el));

  // Grain noise
  (function() {
    const c = document.getElementById('noise-canvas');
    const ctx = c.getContext('2d');
    const S = 200;
    const t = document.createElement('canvas');
    t.width = t.height = S;
    const tc = t.getContext('2d');
    const img = tc.createImageData(S, S);
    for (let i = 0; i < img.data.length; i += 4) {
      const v = Math.random() * 255 | 0;
      img.data[i] = img.data[i+1] = img.data[i+2] = v;
      img.data[i+3] = 255;
    }
    tc.putImageData(img, 0, 0);
    function resize() {
      c.width = window.innerWidth;
      c.height = window.innerHeight;
      const p = ctx.createPattern(t, 'repeat');
      ctx.fillStyle = p;
      ctx.fillRect(0, 0, c.width, c.height);
    }
    resize();
    window.addEventListener('resize', resize);
  })();
</script>
