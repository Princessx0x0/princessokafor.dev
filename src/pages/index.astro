---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Princess Okafor — Cloud Engineer & Builder</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --white:       #FFFFFF;
      --off-white:   #FAFAF9;
      --blush:       #F7F0F4;
      --navy:        #1B3A6B;
      --navy-deep:   #0F2347;
      --blue:        #0055CC;
      --blue-mid:    #2D6BE4;
      --blue-light:  #EBF1FC;
      --rose:        #C4789A;
      --rose-light:  #F5E8EF;
      --ink:         #18182A;
      --ink-muted:   #5C5C78;
      --ink-faint:   #9898B0;
      --rule:        #E2DCE8;
      --vera-bg:     #0F2347;

      --serif: 'Cormorant Garamond', Georgia, serif;
      --sans:  'Inter', system-ui, sans-serif;
      --mono:  'JetBrains Mono', monospace;
    }

    html { scroll-behavior: smooth; }

  
  #chat-fab {
    position: fixed; bottom: 28px; right: 28px;
    width: 52px; height: 52px; border-radius: 50%;
    background: #1B3A6B; border: none; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 4px 20px rgba(27,58,107,0.35);
    transition: transform 0.2s, background 0.2s; z-index: 9999;
  }
  #chat-fab:hover { background: #0055CC; transform: scale(1.07); }
  #chat-fab svg { width: 22px; height: 22px; fill: white; }
  #chat-panel {
    position: fixed; bottom: 92px; right: 28px;
    width: 360px; max-height: 520px; background: #ffffff;
    border: 1px solid #E2DCE8; border-radius: 16px;
    display: flex; flex-direction: column; overflow: hidden;
    z-index: 9998; box-shadow: 0 8px 40px rgba(27,58,107,0.18);
    opacity: 0; transform: translateY(12px) scale(0.97);
    pointer-events: none; transition: opacity 0.22s ease, transform 0.22s ease;
  }
  #chat-panel.open { opacity: 1; transform: translateY(0) scale(1); pointer-events: all; }
  .panel-header {
    background: #0F2347; padding: 1rem 1.25rem;
    display: flex; align-items: center; gap: 0.75rem; flex-shrink: 0;
  }
  .panel-avatar {
    width: 34px; height: 34px; border-radius: 50%;
    background: linear-gradient(135deg, #C4789A, #0055CC);
    display: flex; align-items: center; justify-content: center;
    font-family: Georgia, serif; font-size: 14px; color: white;
    font-style: italic; flex-shrink: 0;
  }
  .panel-title { font-family: Georgia, serif; font-size: 0.95rem; color: white; }
  .panel-sub { font-family: monospace; font-size: 0.62rem; letter-spacing: 0.1em; color: rgba(255,255,255,0.4); text-transform: uppercase; margin-top: 1px; }
  .panel-messages { flex: 1; overflow-y: auto; padding: 1rem; display: flex; flex-direction: column; gap: 0.75rem; min-height: 0; }
  .msg { max-width: 88%; font-family: system-ui, sans-serif; font-size: 0.85rem; line-height: 1.55; padding: 0.65rem 0.9rem; border-radius: 12px; }
  .msg.assistant { background: #F7F0F4; color: #18182A; align-self: flex-start; border-bottom-left-radius: 3px; }
  .msg.user { background: #1B3A6B; color: white; align-self: flex-end; border-bottom-right-radius: 3px; }
  .msg.typing { background: #F7F0F4; align-self: flex-start; color: #9898B0; font-style: italic; }
  .suggestions { display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0 1rem 0.75rem; }
  .sug-btn { font-family: monospace; font-size: 0.67rem; letter-spacing: 0.05em; padding: 0.3rem 0.7rem; border: 1px solid #E2DCE8; background: white; color: #5C5C78; border-radius: 20px; cursor: pointer; transition: border-color 0.15s, color 0.15s; white-space: nowrap; }
  .sug-btn:hover { border-color: #C4789A; color: #C4789A; }
  .panel-input-row { display: flex; gap: 0.5rem; padding: 0.75rem 1rem; border-top: 1px solid #E2DCE8; flex-shrink: 0; }
  .panel-input { flex: 1; font-family: system-ui, sans-serif; font-size: 0.85rem; padding: 0.5rem 0.75rem; border: 1px solid #E2DCE8; border-radius: 8px; outline: none; color: #18182A; background: white; transition: border-color 0.15s; }
  .panel-input:focus { border-color: #1B3A6B; }
  .send-btn { width: 34px; height: 34px; border-radius: 8px; background: #1B3A6B; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: background 0.15s; }
  .send-btn:hover { background: #0055CC; }
  .send-btn svg { width: 15px; height: 15px; fill: white; }

    body {
      font-family: var(--sans);
      background: var(--white);
      color: var(--ink);
      font-size: 16px;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      background-image: radial-gradient(circle, rgba(27,58,107,0.055) 1px, transparent 1px);
      background-size: 28px 28px;
    }

    #noise-canvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 0;
      opacity: 0.028;
      mix-blend-mode: multiply;
    }

    nav, .hero, .vera-section, .blog-section, .projects-section, .about-section, footer {
      position: relative;
      z-index: 1;
    }

    /* ─── NAV ─── */
    nav {
      position: sticky;
      top: 0;
      z-index: 200;
      height: 62px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 2.5rem;
      background: rgba(255,255,255,0.9);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--rule);
    }

    .nav-logo {
      font-family: var(--serif);
      font-size: 1.2rem;
      font-weight: 500;
      color: var(--navy);
      text-decoration: none;
      letter-spacing: 0.02em;
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 2.5rem;
    }

    .nav-links {
      display: flex;
      gap: 2rem;
      list-style: none;
    }

    .nav-links a {
      font-size: 0.78rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-muted);
      text-decoration: none;
      transition: color 0.2s;
    }

    .nav-links a:hover { color: var(--blue); }

    .nav-socials {
      display: flex;
      gap: 1rem;
      align-items: center;
    }

    .nav-socials a {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border: 1px solid var(--rule);
      color: var(--ink-muted);
      text-decoration: none;
      transition: border-color 0.2s, color 0.2s, background 0.2s;
      border-radius: 50%;
    }

    .nav-socials a:hover {
      border-color: var(--blue);
      color: var(--blue);
      background: var(--blue-light);
    }

    .nav-socials svg { width: 15px; height: 15px; fill: currentColor; }

    /* ─── HERO ─── */
    .hero {
      min-height: calc(100vh - 62px);
      display: grid;
      grid-template-columns: 1fr 420px;
      gap: 0;
      align-items: center;
      max-width: 1200px;
      margin: 0 auto;
      padding: 5rem 2.5rem 4rem;
    }

    .hero-left { padding-right: 5rem; }

    .hero-eyebrow {
      font-family: var(--mono);
      font-size: 0.7rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--rose);
      margin-bottom: 1.75rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .hero-eyebrow::before {
      content: '';
      display: inline-block;
      width: 24px;
      height: 1px;
      background: var(--rose);
    }

    .hero-name {
      font-family: var(--serif);
      font-size: clamp(3.8rem, 8vw, 7.5rem);
      font-weight: 300;
      line-height: 0.93;
      color: var(--navy);
      letter-spacing: -0.015em;
      margin-bottom: 1.5rem;
    }

    .hero-name em {
      font-style: italic;
      color: var(--blue-mid);
    }

    .hero-rule {
      width: 100%;
      height: 1px;
      background: linear-gradient(90deg, var(--navy) 0%, var(--rose) 55%, transparent 100%);
      margin-bottom: 2rem;
    }

    .hero-tagline {
      font-family: var(--serif);
      font-size: clamp(1.05rem, 2vw, 1.35rem);
      font-weight: 300;
      color: var(--ink-muted);
      line-height: 1.65;
      margin-bottom: 2.5rem;
      max-width: 520px;
    }

    .hero-tagline strong {
      color: var(--ink);
      font-weight: 500;
    }

    .hero-typewriter {
      font-family: var(--mono);
      font-size: 0.82rem;
      color: var(--blue);
      letter-spacing: 0.04em;
      margin-bottom: 2.5rem;
    }

    .hero-typewriter::before { content: '> '; color: var(--rose); }
    #tw::after { content: '|'; animation: blink 1s step-end infinite; }
    @keyframes blink { 50% { opacity: 0; } }

    .hero-certs {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
    }

    .cert {
      font-family: var(--mono);
      font-size: 0.65rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 0.3rem 0.8rem;
      border: 1px solid var(--navy);
      color: var(--navy);
    }

    /* ─── PHOTO ─── */
    .hero-right {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 1.5rem;
    }

    .photo-frame {
      position: relative;
      width: 360px;
      height: 440px;
    }

    .photo-frame::before {
      content: '';
      position: absolute;
      inset: -10px -10px 10px 10px;
      border: 1px solid var(--rose);
      z-index: 0;
    }

    .photo-frame::after {
      content: '';
      position: absolute;
      inset: 10px -10px -10px 10px;
      border: 1px solid var(--navy);
      z-index: 0;
    }

    .photo-img {
      position: relative;
      z-index: 1;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top center;
      display: block;
      filter: grayscale(8%);
    }

    /* Placeholder shown when no real photo is set */
    .photo-placeholder {
      position: relative;
      z-index: 1;
      width: 100%;
      height: 100%;
      background: linear-gradient(145deg, var(--blush) 0%, var(--blue-light) 100%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      color: var(--ink-muted);
    }

    .photo-placeholder span {
      font-family: var(--mono);
      font-size: 0.68rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--rose);
    }

    .photo-placeholder svg {
      width: 52px;
      height: 52px;
      stroke: var(--ink-faint);
      fill: none;
      stroke-width: 1;
    }

    .photo-social-strip {
      display: flex;
      gap: 0.75rem;
    }

    .social-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.55rem 1.1rem;
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.05em;
      text-decoration: none;
      border: 1px solid var(--rule);
      color: var(--ink-muted);
      transition: all 0.2s;
      white-space: nowrap;
    }

    .social-btn svg { width: 14px; height: 14px; fill: currentColor; flex-shrink: 0; }

    .social-btn:hover {
      border-color: var(--blue);
      color: var(--blue);
      background: var(--blue-light);
    }

    .social-btn.linkedin:hover {
      border-color: #0A66C2;
      color: #0A66C2;
      background: #EEF4FB;
    }

    /* ─── DIVIDER ─── */
    .divider {
      height: 1px;
      background: var(--rule);
    }

    /* ─── VERA SECTION ─── */
    .vera-section {
      background: var(--vera-bg);
      color: white;
      overflow: hidden;
    }

    .vera-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 7rem 2.5rem;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6rem;
      align-items: center;
    }

    .vera-eyebrow {
      font-family: var(--mono);
      font-size: 0.68rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--rose);
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .vera-eyebrow::before {
      content: '';
      width: 24px;
      height: 1px;
      background: var(--rose);
    }

    .vera-heading {
      font-family: var(--serif);
      font-size: clamp(2.8rem, 5vw, 5rem);
      font-weight: 300;
      line-height: 0.95;
      color: white;
      margin-bottom: 0.5rem;
      letter-spacing: -0.01em;
    }

    .vera-heading em {
      font-style: italic;
      color: #7EAAEC;
    }

    .vera-full-name {
      font-family: var(--mono);
      font-size: 0.65rem;
      letter-spacing: 0.15em;
      color: rgba(255,255,255,0.35);
      text-transform: uppercase;
      margin-bottom: 2.5rem;
    }

    .vera-body {
      font-size: 1rem;
      line-height: 1.8;
      color: rgba(255,255,255,0.7);
      margin-bottom: 1.5rem;
    }

    .vera-body strong { color: white; font-weight: 500; }

    .vera-origin {
      font-family: var(--serif);
      font-size: 1.15rem;
      font-style: italic;
      font-weight: 300;
      color: rgba(255,255,255,0.55);
      border-left: 2px solid var(--rose);
      padding-left: 1.25rem;
      margin: 2rem 0;
      line-height: 1.6;
    }

    .vera-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.8rem 1.75rem;
      background: var(--rose);
      color: white;
      font-family: var(--sans);
      font-size: 0.82rem;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      text-decoration: none;
      transition: background 0.2s, transform 0.2s;
      margin-top: 1rem;
    }

    .vera-cta:hover { background: #B0698A; transform: translateX(3px); }
    .vera-cta::after { content: '↗'; }

    .vera-right {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .vera-stat-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1px;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.08);
    }

    .vera-stat {
      background: rgba(255,255,255,0.04);
      padding: 1.75rem 1.5rem;
    }

    .vera-stat-num {
      font-family: var(--serif);
      font-size: 2.4rem;
      font-weight: 300;
      color: white;
      line-height: 1;
      margin-bottom: 0.4rem;
    }

    .vera-stat-label {
      font-family: var(--mono);
      font-size: 0.62rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.35);
    }

    .vera-principles {
      display: flex;
      flex-direction: column;
      gap: 0;
      border: 1px solid rgba(255,255,255,0.08);
    }

    .vera-principle {
      padding: 1.1rem 1.5rem;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      font-size: 0.88rem;
      color: rgba(255,255,255,0.65);
      line-height: 1.5;
    }

    .vera-principle:last-child { border-bottom: none; }

    .vera-principle::before {
      content: '✓';
      font-family: var(--mono);
      font-size: 0.75rem;
      color: var(--rose);
      flex-shrink: 0;
      margin-top: 0.15rem;
    }

    /* ─── BLOG SECTION ─── */
    .blog-section {
      max-width: 1200px;
      margin: 0 auto;
      padding: 6rem 2.5rem;
    }

    .section-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 3rem;
    }

    .section-header-left {
      display: flex;
      align-items: baseline;
      gap: 1.5rem;
    }

    .s-label {
      font-family: var(--mono);
      font-size: 0.67rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--rose);
    }

    .s-title {
      font-family: var(--serif);
      font-size: clamp(2rem, 4vw, 2.8rem);
      font-weight: 400;
      color: var(--navy);
      line-height: 1.1;
    }

    .s-title em { font-style: italic; }

    .s-link {
      font-family: var(--mono);
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--blue);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      transition: gap 0.2s;
    }

    .s-link:hover { gap: 0.7rem; }

    /* VERA blog cluster */
    .blog-vera-cluster {
      margin-bottom: 3rem;
    }

    .cluster-label {
      font-family: var(--mono);
      font-size: 0.63rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--ink-faint);
      margin-bottom: 0;
      padding: 0.6rem 1rem;
      background: var(--blush);
      border-left: 3px solid var(--rose);
      display: inline-block;
    }

    .writing-list { display: flex; flex-direction: column; }

    .writing-item {
      display: grid;
      grid-template-columns: 90px 1fr auto;
      align-items: baseline;
      gap: 2rem;
      padding: 1.35rem 0;
      border-bottom: 1px solid var(--rule);
      text-decoration: none;
      color: inherit;
      transition: padding-left 0.2s;
    }

    .writing-item:first-child { border-top: 1px solid var(--rule); }
    .writing-item:hover { padding-left: 0.4rem; }
    .writing-item:hover .w-title { color: var(--blue); }
    .writing-item:hover .w-arrow { opacity: 1; }

    .w-date {
      font-family: var(--mono);
      font-size: 0.67rem;
      color: var(--ink-faint);
      letter-spacing: 0.04em;
      white-space: nowrap;
    }

    .w-title {
      font-family: var(--serif);
      font-size: 1.2rem;
      font-weight: 400;
      color: var(--ink);
      line-height: 1.3;
      transition: color 0.2s;
    }

    .w-arrow {
      font-size: 0.9rem;
      color: var(--blue);
      opacity: 0;
      transition: opacity 0.2s;
    }

    /* ─── PROJECTS SECTION ─── */
    .projects-section {
      background: var(--off-white);
      border-top: 1px solid var(--rule);
      border-bottom: 1px solid var(--rule);
    }

    .projects-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 6rem 2.5rem;
    }

    .projects-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5px;
      background: var(--rule);
      border: 1.5px solid var(--rule);
      margin-top: 3rem;
    }

    .p-card {
      background: var(--white);
      padding: 2rem 1.75rem;
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      text-decoration: none;
      color: inherit;
      transition: background 0.2s;
    }

    .p-card:hover { background: var(--blue-light); }
    .p-card:hover .p-arrow { transform: translate(3px,-3px); color: var(--blue); }

    .p-glyph {
      font-family: var(--mono);
      font-size: 0.68rem;
      color: var(--rose);
      letter-spacing: 0.1em;
    }

    .p-name {
      font-family: var(--serif);
      font-size: 1.35rem;
      font-weight: 500;
      color: var(--navy);
      line-height: 1.2;
    }

    .p-desc {
      font-size: 0.85rem;
      color: var(--ink-muted);
      line-height: 1.65;
      flex: 1;
    }

    .p-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .tag {
      font-family: var(--mono);
      font-size: 0.62rem;
      letter-spacing: 0.07em;
      color: var(--blue);
      background: var(--blue-light);
      padding: 0.18rem 0.55rem;
    }

    .p-arrow {
      font-size: 1rem;
      color: var(--ink-faint);
      transition: transform 0.2s, color 0.2s;
      align-self: flex-start;
      margin-top: 0.25rem;
    }

    /* ─── ABOUT SECTION ─── */
    .about-section {
      max-width: 1200px;
      margin: 0 auto;
      padding: 6rem 2.5rem;
      display: grid;
      grid-template-columns: 1fr 1.6fr;
      gap: 6rem;
      align-items: start;
    }

    .about-left { position: sticky; top: 82px; }

    .about-stats {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      margin-top: 2.5rem;
    }

    .a-stat-num {
      font-family: var(--serif);
      font-size: 2.2rem;
      font-weight: 300;
      color: var(--navy);
      line-height: 1;
    }

    .a-stat-label {
      font-family: var(--mono);
      font-size: 0.62rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
