---
import { getCollection } from 'astro:content';
const veraposts = await getCollection('vera');
const sorted = veraposts.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VERA Build Series — Princess Okafor</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --navy: #1B3A6B; --navy-deep: #0F2347; --blue: #0055CC;
      --rose: #C4789A; --ink: #18182A; --ink-muted: #5C5C78;
      --rule: #E2DCE8; --white: #FFFFFF; --blush: #F7F0F4;
      --serif: 'Cormorant Garamond', Georgia, serif;
      --sans: 'Inter', system-ui, sans-serif;
      --mono: 'JetBrains Mono', monospace;
    }
    body {
      font-family: var(--sans);
      background: var(--white);
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
      background-image: radial-gradient(circle, rgba(27,58,107,0.055) 1px, transparent 1px);
      background-size: 28px 28px;
    }
    nav {
      position: sticky; top: 0; z-index: 100;
      height: 62px; display: flex; align-items: center;
      justify-content: space-between; padding: 0 2.5rem;
      background: rgba(255,255,255,0.9); backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--rule);
    }
    .nav-logo {
      font-family: var(--serif); font-size: 1.2rem;
      font-weight: 500; color: var(--navy); text-decoration: none;
    }
    .nav-back {
      font-family: var(--mono); font-size: 0.72rem;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--ink-muted); text-decoration: none;
      transition: color 0.2s;
    }
    .nav-back:hover { color: var(--blue); }

    /* Hero band */
    .vera-hero {
      background: var(--navy-deep);
      color: white;
      padding: 6rem 2.5rem 5rem;
    }
    .vera-hero-inner {
      max-width: 800px;
      margin: 0 auto;
    }
    .eyebrow {
      font-family: var(--mono);
      font-size: 0.68rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--rose);
      margin-bottom: 1.5rem;
      display: flex; align-items: center; gap: 0.75rem;
    }
    .eyebrow::before { content: ''; width: 24px; height: 1px; background: var(--rose); }
    .vera-title {
      font-family: var(--serif);
      font-size: clamp(3rem, 7vw, 6rem);
      font-weight: 300;
      line-height: 0.95;
      color: white;
      margin-bottom: 1rem;
    }
    .vera-title em { font-style: italic; color: #7EAAEC; }
    .vera-subtitle {
      font-family: var(--mono);
      font-size: 0.65rem;
      letter-spacing: 0.15em;
      color: rgba(255,255,255,0.3);
      text-transform: uppercase;
      margin-bottom: 2.5rem;
    }
    .vera-intro {
      font-size: 1.05rem;
      line-height: 1.8;
      color: rgba(255,255,255,0.65);
      max-width: 640px;
    }
    .vera-intro strong { color: white; font-weight: 500; }

    /* Posts list */
    .posts-wrap {
      max-width: 800px;
      margin: 0 auto;
      padding: 5rem 2.5rem 8rem;
    }
    .posts-label {
      font-family: var(--mono);
      font-size: 0.67rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--rose);
      margin-bottom: 2rem;
      display: flex; align-items: center; gap: 0.75rem;
    }
    .posts-label::before { content: ''; width: 24px; height: 1px; background: var(--rose); }

    .post-item {
      display: grid;
      grid-template-columns: 48px 1fr;
      gap: 2rem;
      padding: 2rem 0;
      border-bottom: 1px solid var(--rule);
      text-decoration: none;
      color: inherit;
      transition: padding-left 0.2s;
      align-items: start;
    }
    .post-item:first-child { border-top: 1px solid var(--rule); }
    .post-item:hover { padding-left: 0.5rem; }
    .post-item:hover .post-title { color: var(--blue); }
    .post-item:hover .post-arrow { opacity: 1; }

    .post-num {
      font-family: var(--serif);
      font-size: 2.5rem;
      font-weight: 300;
      color: var(--rose);
      opacity: 0.4;
      line-height: 1;
      padding-top: 0.2rem;
    }
    .post-content { display: flex; flex-direction: column; gap: 0.5rem; }
    .post-title {
      font-family: var(--serif);
      font-size: 1.5rem;
      font-weight: 400;
      color: var(--navy);
      line-height: 1.2;
      transition: color 0.2s;
    }
    .post-desc {
      font-size: 0.9rem;
      color: var(--ink-muted);
      line-height: 1.65;
    }
    .post-meta {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-top: 0.5rem;
    }
    .post-date {
      font-family: var(--mono);
      font-size: 0.65rem;
      letter-spacing: 0.08em;
      color: var(--ink-muted);
    }
    .post-arrow {
      font-size: 0.85rem;
      color: var(--blue);
      opacity: 0;
      transition: opacity 0.2s;
    }

    /* Coming soon state */
    .post-item.coming-soon {
      opacity: 0.45;
      pointer-events: none;
    }
    .coming-tag {
      font-family: var(--mono);
      font-size: 0.6rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--rose);
      border: 1px solid var(--rose);
      padding: 0.15rem 0.5rem;
    }
  </style>
</head>
<body>
  <nav>
    <a class="nav-logo" href="/">Princess Okafor</a>
    <a class="nav-back" href="/#vera">← Back to VERA</a>
  </nav>

  <div class="vera-hero">
    <div class="vera-hero-inner">
      <p class="eyebrow">Build series</p>
      <h1 class="vera-title"><em>VERA</em></h1>
      <p class="vera-subtitle">Verified · Explainable · Responsible Assessment</p>
      <p class="vera-intro">
        An honest account of building an AI hiring assessment platform from scratch —
        the architecture decisions, the things that broke, the research behind the fairness philosophy,
        and <strong>why this product exists at all</strong>.
        Written as it gets built.
      </p>
    </div>
  </div>

  <div class="posts-wrap">
    <p class="posts-label">All posts</p>

    <a href="/blog/vera-why-i-built-it" class="post-item">
      <div class="post-num">01</div>
      <div class="post-content">
        <div class="post-title">Why I Built VERA: The 2AM Rejection That Started Everything</div>
        <div class="post-desc">The origin story — an unexplained automated rejection, and what it revealed about how broken AI hiring tools really are.</div>
        <div class="post-meta">
          <span class="post-date">Jul 3 2026</span>
          <span class="post-arrow">↗</span>
        </div>
      </div>
    </a>

    <a href="/blog/vera-architecture" class="post-item">
      <div class="post-num">02</div>
      <div class="post-content">
        <div class="post-title">VERA's Architecture: FastAPI, Gemini 2.5, and the Scoring Pipeline</div>
        <div class="post-desc">How the backend is structured — the two-pass LLM framework generator, the scoring pipeline, and why Gemini 2.5 Pro handles assessment while Flash handles generation.</div>
        <div class="post-meta">
          <span class="post-date">Jul 7 2026</span>
          <span class="post-arrow">↗</span>
        </div>
      </div>
    </a>

    <a href="/blog/vera-429-wall" class="post-item">
      <div class="post-num">03</div>
      <div class="post-content">
        <div class="post-title">The 429 Wall: Hidden Regional Quotas, a Data Residency Tradeoff, and the 16-Second UX Ceiling</div>
        <div class="post-desc">VERA's production environment ground to a halt mid-interview. The culprit was a regional quota we couldn't even see.</div>
        <div class="post-meta">
          <span class="post-date">Jul 8 2026</span>
          <span class="post-arrow">↗</span>
        </div>
      </div>
    </a>

  </div>
</body>
</html>