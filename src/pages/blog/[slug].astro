---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{post.data.title} — Princess Okafor</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --navy: #1B3A6B; --blue: #0055CC; --rose: #C4789A;
      --ink: #18182A; --ink-muted: #5C5C78; --rule: #E2DCE8;
      --white: #FFFFFF;
      --serif: 'Cormorant Garamond', Georgia, serif;
      --sans: 'Inter', system-ui, sans-serif;
      --mono: 'JetBrains Mono', monospace;
    }
    body {
      font-family: var(--sans);
      background: var(--white);
      color: var(--ink);
      font-size: 16px;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      background-image: radial-gradient(circle, rgba(27,58,107,0.055) 1px, transparent 1px);
      background-size: 28px 28px;
    }
    nav {
      position: sticky; top: 0; z-index: 100;
      height: 62px; display: flex; align-items: center;
      justify-content: space-between; padding: 0 2.5rem;
      background: rgba(255,255,255,0.9); backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--rule);
    }
    .nav-logo {
      font-family: var(--serif); font-size: 1.2rem;
      font-weight: 500; color: var(--navy); text-decoration: none;
    }
    .nav-back {
      font-family: var(--mono); font-size: 0.72rem;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--ink-muted); text-decoration: none;
      display: flex; align-items: center; gap: 0.5rem;
      transition: color 0.2s;
    }
    .nav-back:hover { color: var(--blue); }
    .post-wrap {
      max-width: 720px; margin: 0 auto;
      padding: 5rem 2.5rem 8rem;
    }
    .post-eyebrow {
      font-family: var(--mono); font-size: 0.68rem;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--rose); margin-bottom: 1.5rem;
      display: flex; align-items: center; gap: 0.75rem;
    }
    .post-eyebrow::before {
      content: ''; width: 24px; height: 1px; background: var(--rose);
    }
    .post-title {
      font-family: var(--serif);
      font-size: clamp(2.2rem, 5vw, 3.5rem);
      font-weight: 300; line-height: 1.1;
      color: var(--navy); margin-bottom: 1rem;
      letter-spacing: -0.01em;
    }
    .post-desc {
      font-family: var(--serif); font-size: 1.15rem;
      font-weight: 300; color: var(--ink-muted);
      line-height: 1.65; margin-bottom: 2rem;
    }
    .post-rule {
      width: 100%; height: 1px;
      background: linear-gradient(90deg, var(--navy) 0%, var(--rose) 55%, transparent 100%);
      margin-bottom: 3rem;
    }
    .post-tags {
      display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 3rem;
    }
    .tag {
      font-family: var(--mono); font-size: 0.62rem;
      letter-spacing: 0.08em; color: var(--blue);
      background: #EBF1FC; padding: 0.2rem 0.6rem;
    }
    /* Prose styles */
    .prose h2 {
      font-family: var(--serif); font-size: 1.9rem;
      font-weight: 400; color: var(--navy);
      margin: 3rem 0 1rem; line-height: 1.2;
    }
    .prose h3 {
      font-family: var(--serif); font-size: 1.4rem;
      font-weight: 400; color: var(--navy);
      margin: 2rem 0 0.75rem;
    }
    .prose p { margin-bottom: 1.5rem; line-height: 1.85; color: var(--ink-muted); }
    .prose p strong { color: var(--ink); font-weight: 500; }
    .prose a { color: var(--blue); text-decoration: underline; text-underline-offset: 3px; }
    .prose ul, .prose ol { margin: 0 0 1.5rem 1.5rem; }
    .prose li { margin-bottom: 0.5rem; color: var(--ink-muted); line-height: 1.75; }
    .prose pre {
      background: #0F2347; border-radius: 0;
      padding: 1.5rem; overflow-x: auto;
      margin: 2rem 0; border-left: 3px solid var(--rose);
    }
    .prose code {
      font-family: var(--mono); font-size: 0.85rem;
      color: #A8C8FF; line-height: 1.6;
    }
    .prose p code, .prose li code {
      background: #EBF1FC; color: var(--blue);
      padding: 0.15rem 0.4rem; border-radius: 0;
    }
    .prose blockquote {
      border-left: 2px solid var(--rose);
      padding-left: 1.5rem; margin: 2rem 0;
      font-family: var(--serif); font-size: 1.15rem;
      font-style: italic; color: var(--ink-muted);
    }
    .prose img { max-width: 100%; margin: 2rem 0; }
    .prose hr { border: none; border-top: 1px solid var(--rule); margin: 3rem 0; }
  </style>
</head>
<body>
  <nav>
    <a class="nav-logo" href="/">Princess Okafor</a>
    <a class="nav-back" href="/#blog">← All writing</a>
  </nav>
  <article class="post-wrap">
    <p class="post-eyebrow">{post.data.date}</p>
    <h1 class="post-title">{post.data.title}</h1>
    {post.data.description && <p class="post-desc">{post.data.description}</p>}
    <div class="post-rule"></div>
    {post.data.tags && (
      <div class="post-tags">
        {post.data.tags.map((tag: string) => <span class="tag">{tag}</span>)}
      </div>
    )}
    <div class="prose">
      <Content />
    </div>
  </article>
</body>
</html>