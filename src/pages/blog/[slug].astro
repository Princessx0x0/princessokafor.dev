---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';

/* One route serves both collections. VERA posts get the build-series chrome,
   everything else gets the plain writing chrome. */
export async function getStaticPaths() {
  const blog = await getCollection('blog');
  const vera = await getCollection('vera');

  return [
    ...blog
      .filter(post => !post.data.draft)
      .map(post => ({ params: { slug: post.id }, props: { post, series: false } })),
    ...vera.map(post => ({ params: { slug: post.id }, props: { post, series: true } })),
  ];
}

const { post, series } = Astro.props;
const { Content } = await render(post);

const fmtDate = (d: string) =>
  new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const eyebrow = series
  ? `VERA · Build series · ${fmtDate(post.data.date)}`
  : fmtDate(post.data.date);

const backHref = series ? '/blog/vera' : '/#blog';
const backLabel = series ? '← VERA build series' : '← All writing';

const footerLinks = series
  ? [
      { href: '/blog/vera', label: '← Back to VERA series' },
      { href: '/#blog', label: 'All writing →' },
    ]
  : [{ href: '/#blog', label: '← All writing' }];
---
<PostLayout
  title={post.data.title}
  description={post.data.description}
  path={`/blog/${post.id}`}
  eyebrow={eyebrow}
  tags={post.data.tags}
  backHref={backHref}
  backLabel={backLabel}
  footerLinks={footerLinks}
>
  <Content />
</PostLayout>
